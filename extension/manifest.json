{
  "manifest_version": 3,
  "name": "OpenFeedling",
  "version": "0.2.0",
  "description": "Watches your YouTube history and nudges you when you've been scrolling Shorts too long. Cat-themed.",
  "permissions": ["cookies", "storage", "alarms", "notifications"],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "host_permissions": [
    "https://*.youtube.com/*",
    "https://*.google.com/*",
    "https://fcm.googleapis.com/*",
    "https://updates.push.services.mozilla.com/*",
    "https://web.push.apple.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "OpenFeedling",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
